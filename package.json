{
  "name": "ppfq",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "db:up": "docker compose up -d --wait postgres",
    "db:ui": "docker compose up -d --wait adminer",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:import-referential": "tsx scripts/import-referential.ts",
    "db:seed-flags": "tsx scripts/seed-flags.ts",
    "ingest:career": "tsx --conditions=react-server scripts/import-career.ts",
    "fixtures:wikidata": "tsx --conditions=react-server scripts/capture-wikidata-fixtures.ts",
    "test": "docker compose up -d --wait postgres-test && vitest run --project '!live'",
    "test:watch": "docker compose up -d --wait postgres-test && vitest --project '!live'",
    "test:fast": "vitest run --project domain --project architecture",
    "test:db": "docker compose up -d --wait postgres-test && vitest run --project postgres",
    "test:live": "docker compose up -d --wait postgres-test && vitest run --project live"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "next": "16.3.4",
    "pg": "8.23.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "0.0.1",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^24.13.3",
    "@types/pg": "8.23.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "eslint-plugin-sonarjs": "^4.2.0",
    "flag-icons": "7.5.0",
    "sharp": "^0.35.4",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.0"
  }
}
