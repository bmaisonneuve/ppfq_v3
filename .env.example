# Copy to `.env.local` (git-ignored) and adjust. `docker compose up -d postgres`
# serves the development database on these credentials out of the box.
DATABASE_URL=postgres://ppfq:ppfq@localhost:5432/ppfq

# Used by the integration suite only. `pnpm test` starts the container itself.
TEST_DATABASE_URL=postgres://ppfq:ppfq@localhost:5433/ppfq_test

# Host ports, if 5432/5433 are already taken on your machine.
# POSTGRES_PORT=5432
# POSTGRES_TEST_PORT=5433

# SPARQL endpoint the career import reads. Defaults to QLever
# (https://qlever.dev/api/wikidata), a third-party mirror of a Wikidata
# snapshot: far faster than query.wikidata.org, at the cost of lagging it by a
# few days. Point this elsewhere if either one goes down.
# WIKIDATA_SPARQL_ENDPOINT=https://qlever.dev/api/wikidata

# Le compte (#13). Sans ce secret, la connexion par email reste fermée — pour
# les joueurs comme pour l'admin — et elle le dit. `openssl rand -base64 32`.
# Le faire tourner déconnecte toutes les sessions ouvertes d'un coup ; c'est le
# seul mécanisme de révocation qu'il y a.
BETTER_AUTH_SECRET=

# L'origine publique. Elle sert à deux choses qui doivent être d'accord : la
# base de Better Auth, et l'URL écrite dans l'email du lien magique — un lien
# qui pointe ailleurs qu'ici ne connecte personne.
APP_URL=http://localhost:3000

# Le relais qui envoie les emails de connexion. **Jamais le SMTP de la machine**
# (docs/stack-technique.md §4bis) : une IP fraîche part en spam, et Hetzner
# ferme le port 25 sur les nouveaux comptes. En développement c'est Mailpit,
# démarré par `pnpm test` et consultable sur http://localhost:8025
# (`pnpm mail:ui`) ; en production, le relais de Scaleway TEM.
# Sans cette variable, aucun email ne part et la demande de code est refusée.
MAIL_SMTP_URL=smtp://localhost:1025
MAIL_FROM=Footguessr <jeu@localhost>

# Ports hôte de Mailpit, si 1025/8025 sont pris.
# MAILPIT_SMTP_PORT=1025
# MAILPIT_HTTP_PORT=8025

# La porte du back-office (#13, ADR-0006) : les adresses qui ouvrent /admin,
# séparées par des virgules. Vide, /admin refuse tout le monde — y compris vous,
# et c'est voulu : un back-office qui s'ouvre parce qu'une variable manque
# échoue du côté qui laisse entrer.
ADMIN_EMAILS=
