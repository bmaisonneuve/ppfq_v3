# Copy to `.env.local` (git-ignored) and adjust. `docker compose up -d postgres`
# serves the development database on these credentials out of the box.
DATABASE_URL=postgres://ppfq:ppfq@localhost:5432/ppfq

# Used by the integration suite only. `pnpm test` starts the container itself.
TEST_DATABASE_URL=postgres://ppfq:ppfq@localhost:5433/ppfq_test

# Host ports, if 5432/5433 are already taken on your machine.
# POSTGRES_PORT=5432
# POSTGRES_TEST_PORT=5433
